<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="460.0" styleClass="background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kinal.recruitment.controller.RegisterController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="360.0" spacing="10.0" styleClass="card">
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
         </padding>
         <children>
            <Label styleClass="heading" text="Crear cuenta" />
            <Label styleClass="field-label" text="Completa tus datos para registrarte">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <Label maxWidth="Infinity" styleClass="field-label" text="Usuario" />
            <TextField fx:id="txtUsername" promptText="Tu nombre de usuario" />
            <Label maxWidth="Infinity" styleClass="field-label" text="Correo electrónico" />
            <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" />
            <Label maxWidth="Infinity" styleClass="field-label" text="Contraseña (mínimo 6 caracteres)" />
            <PasswordField fx:id="txtPassword" promptText="Tu contraseña" />
            <Label maxWidth="Infinity" styleClass="field-label" text="Confirmar contraseña" />
            <PasswordField fx:id="txtConfirmPassword" onAction="#handleRegister" promptText="Repite tu contraseña" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRegister" styleClass="button-primary" text="Registrarme">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </Button>
            <HBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label styleClass="field-label" text="¿Ya tienes cuenta?" />
                  <Hyperlink onAction="#handleGoToLogin" text="Inicia sesión" visited="true" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
