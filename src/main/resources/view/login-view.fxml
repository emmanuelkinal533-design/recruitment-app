<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="460.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kinal.recruitment.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="360.0" spacing="10.0">
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
         </padding>
         <children>
            <Label text="Reclutamiento" />
            <Label text="Inicia sesión para continuar">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <Label maxWidth="Infinity" text="Correo electrónico" />
            <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" />
            <Label maxWidth="Infinity" text="Contraseña" />
            <PasswordField fx:id="txtPassword" onAction="#handleLogin" promptText="Tu contraseña" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" text="Iniciar sesión">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </Button>
            <HBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label text="¿No tienes cuenta?" />
                  <Hyperlink onAction="#handleGoToRegister" text="Regístrate" visited="true" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>