<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1220.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kinal.recruitment.controller.ApplicantController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <Label text="Inventario de aspirantes" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUser" />
            <Button mnemonicParsing="false" onAction="#handleLogout" text="Cerrar sesión" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="8.0" top="16.0" />
         </padding>
         <children>
            <Label fx:id="lblCount" text="0 aspirantes" />
            <TableView fx:id="tblApplicants" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" maxWidth="70.0" minWidth="45.0" prefWidth="55.0" text="ID" />
                  <TableColumn fx:id="colFirstName" prefWidth="110.0" text="Nombre" />
                  <TableColumn fx:id="colLastName" prefWidth="110.0" text="Apellido" />
                  <TableColumn fx:id="colEmail" prefWidth="190.0" text="Correo" />
                  <TableColumn fx:id="colPhone" prefWidth="110.0" text="Teléfono" />
                  <TableColumn fx:id="colAddress" prefWidth="190.0" text="Dirección" />
                  <TableColumn fx:id="colAge" maxWidth="80.0" minWidth="50.0" prefWidth="60.0" text="Edad" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="290.0" spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="16.0" left="8.0" right="16.0" top="16.0" />
         </BorderPane.margin>
         <children>
            <Label text="Datos del aspirante" />
            <Label text="Nombre" />
            <TextField fx:id="txtFirstName" promptText="Ej. María" />
            <Label text="Apellido" />
            <TextField fx:id="txtLastName" promptText="Ej. López" />
            <Label text="Correo" />
            <TextField fx:id="txtEmail" promptText="Ej. maria@correo.com" />
            <Label text="Teléfono" />
            <TextField fx:id="txtPhone" promptText="Ej. 5555-1234" />
            <Label text="Dirección" />
            <TextField fx:id="txtAddress" promptText="Ej. 5a avenida 10-20 zona 1" />
            <Label text="Edad" />
            <TextField fx:id="txtAge" promptText="Ej. 25" />
            <Label fx:id="lblMessage" wrapText="true" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAdd" text="Agregar" />
            <Button fx:id="btnUpdate" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUpdate" text="Actualizar" />
            <Button fx:id="btnDelete" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDelete" text="Eliminar" />
            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleClear" text="Limpiar" />
         </children>
      </VBox>
   </right>
</BorderPane>